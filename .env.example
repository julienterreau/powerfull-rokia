NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WEBCALLHUB_ID=86035c81-4ea2-4ac6-9a65-5a6f29d0c366

# Sanity : contenu, audios, livre d'or, newsletter et diagnostics envoyés.
# SANITY_PROJECT_ID : identifiant du projet (sanity.io/manage).
# SANITY_DATASET : nom du jeu de données, en général production.
# SANITY_API_TOKEN : jeton avec droit d'écriture, utilisé par le site.
# Les deux variables NEXT_PUBLIC_ reprennent le même projet et le même dataset pour le studio.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_API_VERSION=2026-10-22
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
