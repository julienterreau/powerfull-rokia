NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WEBCALLHUB_ID=86035c81-4ea2-4ac6-9a65-5a6f29d0c366
REVALIDATE_SECRET=change-me

# Payload. Sans DATABASE_URL, une base SQLite locale est utilisée.
PAYLOAD_SECRET=change-me-with-a-long-random-string
DATABASE_URL=

# Cloudflare R2. Laisser les clés vides en local : les fichiers restent dans apps/web/media.
# En production, autoriser PUT depuis l'origine du site (CORS) pour les audios volumineux.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=powerfullrokia-media
R2_PUBLIC_URL=https://media.powerfullrokia.link
