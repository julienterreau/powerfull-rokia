{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "coverAlt": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "blocks.paragraph",
        "blocks.heading",
        "blocks.quote",
        "blocks.verse",
        "blocks.youtube",
        "blocks.note"
      ]
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "author": {
      "type": "string",
      "default": "Powerfull Rokia"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}